[Unit]
Description=Refresh SYYH COSfs temporary credentials from bound CVM role
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=syyh-cos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /opt/website/syyh/storage/cvm-cos-credentials.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/syyh-cos
TimeoutStartSec=20
