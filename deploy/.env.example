# Local V3 defaults. Create the private fixture paths first; never use a real password here.
RELEASE=v3-local
VCS_REF=unknown
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SYYH_TLS=off
PUBLIC_ORIGIN=http://localhost:8080
ALLOW_INSECURE_DEV=1
STORE_ID=syyh-v3-local-fixture
COS_SITE_ROOT=../.local/store
TLS_EDGE_ROOT=../.local/tls/edge
ACME_ROOT=../.local/tls/acme
OWNER_SECRET_FILE=../.local/owner-password.json
SFTP_INBOX_ROOT=../.local/inbox
DATA_VOLUME=syyh-draft-local-guestbook
CONTENT_VOLUME=syyh-v3-local-content
UPLOAD_VOLUME=syyh-v3-local-uploads
